<mxfile host="drawio"><diagram name="Event-driven orders: containers"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1760" height="900" as="geometry"/></mxCell><mxCell id="c4" value="Event-driven order system" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="c5" value="Container diagram (C4 level 2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="900" height="22" as="geometry"/></mxCell><mxCell id="c6" value="Customer&#x27;s app&lt;br&gt;(places and tracks orders)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="64" y="262" width="30" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Kubernetes cluster (kind), installed with Helm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;fontColor=#545B64;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="1000" height="690" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Orders service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[TypeScript, NestJS, 2 replicas]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;REST API: takes orders idempotently, tracks status, publishes events through an outbox&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="220" width="260" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Inventory service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Java 21, Spring Boot, 2 replicas]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Answers stock queries over gRPC; reserves and releases stock, each event exactly once&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="220" width="260" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Event broker&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Apache Kafka 4.3, KRaft]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;orders.events and inventory.events, keyed by order id; a dead-letter topic for each&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="540" y="400" width="220" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Orders database&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[PostgreSQL 17]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Orders, lines, outbox, processed events&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="620" width="190" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Inventory database&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[PostgreSQL 17]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Products, reservations, outbox, processed events&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="620" width="190" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Tracing&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Jaeger, OpenTelemetry]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Both services export traces; one trace follows an order end to end&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="540" y="640" width="220" height="100" as="geometry"/></mxCell><mxCell id="c14" value="Places orders&lt;br&gt;[REST, Idempotency-Key]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="Checks availability&lt;br&gt;[gRPC, 300 ms deadline]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="OrderPlaced,&lt;br&gt;OrderCancelled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="439"/></Array></mxGeometry></mxCell><mxCell id="c17" value="StockReserved,&lt;br&gt;Rejected, Released" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="325" y="497"/></Array></mxGeometry></mxCell><mxCell id="c18" value="Order events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="885" y="439"/></Array></mxGeometry></mxCell><mxCell id="c19" value="Stock results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="497"/></Array></mxGeometry></mxCell><mxCell id="c20" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.49;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="What it guarantees" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="120" width="460" height="22" as="geometry"/></mxCell><mxCell id="c23" value="No order is lost: it is saved with its event in one transaction (outbox), so Kafka and inventory can both be down." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="152" width="460" height="50" as="geometry"/></mxCell><mxCell id="c24" value="Stock is never oversold: rows are locked in SKU order, and a CHECK constraint backs it up." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="206" width="460" height="50" as="geometry"/></mxCell><mxCell id="c25" value="Each event takes effect once: its id is recorded in the same transaction as its effect." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="260" width="460" height="50" as="geometry"/></mxCell><mxCell id="c26" value="Each order&#x27;s events are handled in order: one partition per order id, one relay publishing at a time." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="314" width="460" height="50" as="geometry"/></mxCell><mxCell id="c27" value="A malformed message goes to a dead-letter topic instead of blocking everything behind it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="368" width="460" height="50" as="geometry"/></mxCell><mxCell id="c28" value="Measured on the cluster" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="428" width="460" height="20" as="geometry"/></mxCell><mxCell id="c29" value="40 orders for 10 monitors: exactly 10 confirmed.&lt;br&gt;Inventory down: 20 of 20 orders accepted, all confirmed 16 s after it returned.&lt;br&gt;Kafka down: 20 of 20 accepted, all confirmed 34 s after it returned.&lt;br&gt;Accepted to confirmed: p50 231 ms, p95 304 ms." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="450" width="460" height="90" as="geometry"/></mxCell><mxCell id="c30" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="760" width="460" height="20" as="geometry"/></mxCell><mxCell id="c31" value="Solid: requests and events&lt;br&gt;Grey border: observability" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="782" width="460" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>