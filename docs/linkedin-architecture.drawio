 messages go to a dead-letter topic" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22" y="392" width="500" height="20" as="geometry"/></mxCell><mxCell id="c21" value="Measured on a 3-node Kubernetes cluster" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="22" y="430" width="500" height="20" as="geometry"/></mxCell><mxCell id="c22" value="40 orders for 10 monitors: exactly 10 confirmed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22" y="456" width="500" height="20" as="geometry"/></mxCell><mxCell id="c23" value="Inventory down: 20 of 20 orders accepted, none lost" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22" y="478" width="500" height="20" as="geometry"/></mxCell><mxCell id="c24" value="Kafka down: 20 of 20 accepted, all confirmed after" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22" y="500" width="500" height="20" as="geometry"/></mxCell><mxCell id="c25" value="Accepted to confirmed: p50 231 ms" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22" y="522" width="500" height="20" as="geometry"/></mxCell><mxCell id="c26" value="CI builds both services, runs them on Kubernetes and repeats the outage drills on every push." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAl